    "\n" <>
    "      --json\n" <>
    "          Output as JSON\n" <>
    "\n" <>
    "      --no-daemon\n" <>
    "          Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "\n" <>
    "      --no-auto-flush\n" <>
    "          Skip auto JSONL export\n" <>
    "\n" <>
    "      --no-auto-import\n" <>
    "          Skip auto import check\n" <>
    "\n" <>
    "      --allow-stale\n" <>
    "          Allow stale DB (bypass freshness check warning)\n" <>
    "\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>\n" <>
    "          `SQLite` busy/write-lock timeout in ms\n" <>
    "\n" <>
    "      --no-db\n" <>
    "          JSONL-only mode (no DB connection)\n" <>
    "\n" <>
    "  -v, --verbose...\n" <>
    "          Increase logging verbosity (-v, -vv)\n" <>
    "\n" <>
    "  -q, --quiet\n" <>
    "          Quiet mode (no output except errors)\n" <>
    "\n" <>
    "      --no-color\n" <>
    "          Disable colored output\n" <>
    "\n" <>
    "  -h, --help\n" <>
    "          Print help (see a summary with '-h')\n" <>
    Nil{})

# S1.29 S1.89 (data) `br create -h`, verbatim
def h_create_short() -> String:
  String.concat(
    "Create a new issue\n" <>
    "\n" <>
    "Usage: br create [OPTIONS] [TITLE]\n" <>
    "\n" <>
    "Arguments:\n" <>
    "  [TITLE]  Issue title\n" <>
    "\n" <>
    "Options:\n" <>
    "      --title <TITLE_FLAG>\n" <>
    "          Issue title (alternative to positional argument)\n" <>
    "  -t, --type <TYPE>\n" <>
    "          Issue type (task, bug, feature, etc.)\n" <>
    "      --slug <SLUG>\n" <>
    "          Human-readable slug embedded in the generated ID. Example: `--slug survey-my-thing` produces an ID of the form `br-survey-my-thing-<hash>`, keeping the configured prefix and the uniquifying hash suffix. The slug is normalized to lowercase ASCII alphanumeric + single hyphens (runs of other characters collapse to one hyphen, leading/trailing hyphens are stripped, length is capped at 48 characters after normalization)\n" <>
    "  -p, --priority <PRIORITY>\n" <>
    "          Priority (0-4 or P0-P4)\n" <>
    "  -d, --description <DESCRIPTION>\n" <>
    "          Description [alias: --body]\n" <>
    "      --description-file <PATH>\n" <>
    "          Read the issue description verbatim from a file (or `-` for stdin)\n" <>
    "  -a, --assignee <ASSIGNEE>\n" <>
    "          Assign to person\n" <>
    "      --owner <OWNER>\n" <>
    "          Set owner email\n" <>
    "  -l, --labels <LABELS>\n" <>
    "          Labels (comma-separated)\n" <>
    "      --parent <PARENT>\n" <>
    "          Parent issue ID (creates parent-child dep)\n" <>
    "      --deps <DEPS>\n" <>
    "          Dependencies (format: type:id,type:id)\n" <>
    "  -e, --estimate <ESTIMATE>\n" <>
    "          Time estimate in minutes\n" <>
    "      --due <DUE>\n" <>
    "          Due date (RFC3339 or relative)\n" <>
    "      --defer <DEFER>\n" <>
    "          Defer until date (RFC3339 or relative)\n" <>
    "      --external-ref <EXTERNAL_REF>\n" <>
    "          External reference\n" <>
    "      --ephemeral\n" <>
    "          Mark as ephemeral (not exported to JSONL)\n" <>
    "  -s, --status <STATUS>\n" <>
    "          Initial status (open, deferred, in_progress, closed)\n" <>
    "      --acceptance-criteria <ACCEPTANCE_CRITERIA>\n" <>
    "          Acceptance criteria recorded on the initial issue (beads_rust#408) [alias: --acceptance]\n" <>
    "      --prerequisites <PREREQUISITES>\n" <>
    "          Prerequisite checklist recorded separately from acceptance criteria\n" <>
    "      --agent-context <AGENT_CONTEXT>\n" <>
    "          Set the initial `agent_context` governing-instructions JSON (beads_rust#408)\n" <>
    "      --dry-run\n" <>
    "          Preview without creating\n" <>
    "      --silent\n" <>
    "          Output only issue ID\n" <>
    "  -f, --file <FILE>\n" <>
    "          Create issues from a markdown file (bulk import)\n" <>
    "      --agent-name <NAME>\n" <>
    "          Tier 1 attribution: agent name (env: BR_AGENT_NAME). Recorded only [env: BR_AGENT_NAME=]\n" <>
    "      --harness <HARNESS>\n" <>
    "          Tier 1 attribution: harness identifier (env: BR_HARNESS). Recorded only [env: BR_HARNESS=]\n" <>
    "      --model <MODEL>\n" <>
    "          Tier 1 attribution: model identifier (env: BR_MODEL). Recorded only [env: BR_MODEL=]\n" <>
    "      --db <DB>\n" <>
    "          Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "      --actor <ACTOR>\n" <>
    "          Actor name for audit trail\n" <>
    "      --json\n" <>
    "          Output as JSON\n" <>
    "      --no-daemon\n" <>
    "          Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "      --no-auto-flush\n" <>
    "          Skip auto JSONL export\n" <>
    "      --no-auto-import\n" <>
    "          Skip auto import check\n" <>
    "      --allow-stale\n" <>
    "          Allow stale DB (bypass freshness check warning)\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>\n" <>
    "          `SQLite` busy/write-lock timeout in ms\n" <>
    "      --no-db\n" <>
    "          JSONL-only mode (no DB connection)\n" <>
    "  -v, --verbose...\n" <>
    "          Increase logging verbosity (-v, -vv)\n" <>
    "  -q, --quiet\n" <>
    "          Quiet mode (no output except errors)\n" <>
    "      --no-color\n" <>
    "          Disable colored output\n" <>
    "  -h, --help\n" <>
    "          Print help (see more with '--help')\n" <>
    Nil{})

