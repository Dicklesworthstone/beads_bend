# S1.29 S1.89 (data) `br close --help`, verbatim
def h_close_long() -> String:
  String.concat(
    "Close an issue\n" <>
    "\n" <>
    "Usage: br close [OPTIONS] [IDS]...\n" <>
    "\n" <>
    "Arguments:\n" <>
    "  [IDS]...  Issue IDs to close (uses last-touched if empty)\n" <>
    "\n" <>
    "Options:\n" <>
    "  -r, --reason <REASON>               Close reason\n" <>
    "      --transition-comment <COMMENT>  New comment committed atomically with each close transition. This is distinct from close metadata in `--reason`\n" <>
    "  -f, --force                         Close even if blocked by open dependencies\n" <>
    "      --suggest-next                  After closing, return newly unblocked issues (single ID only)\n" <>
    "      --session <SESSION>             Session ID for tracking\n" <>
    "      --robot                         Machine-readable output (alias for --json)\n" <>
    "      --agent-name <NAME>             Tier 1 attribution: agent name (env: BR_AGENT_NAME) [env: BR_AGENT_NAME=]\n" <>
    "      --harness <HARNESS>             Tier 1 attribution: harness identifier (env: BR_HARNESS) [env: BR_HARNESS=]\n" <>
    "      --model <MODEL>                 Tier 1 attribution: model identifier (env: BR_MODEL) [env: BR_MODEL=]\n" <>
    "      --bypass-policy                 Bypass closure-time policy gates. Requires `--bypass-reason`. Only honoured when `.beads/policy.yaml` has `allow_bypass: true` (which is the default)\n" <>
    "      --bypass-reason <REASON>        Reason for bypassing policy gates. Required when `--bypass-policy` is set\n" <>
    "      --db <DB>                       Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "      --actor <ACTOR>                 Actor name for audit trail\n" <>
    "      --json                          Output as JSON\n" <>
    "      --no-daemon                     Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "      --no-auto-flush                 Skip auto JSONL export\n" <>
    "      --no-auto-import                Skip auto import check\n" <>
    "      --allow-stale                   Allow stale DB (bypass freshness check warning)\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>   `SQLite` busy/write-lock timeout in ms\n" <>
    "      --no-db                         JSONL-only mode (no DB connection)\n" <>
    "  -v, --verbose...                    Increase logging verbosity (-v, -vv)\n" <>
    "  -q, --quiet                         Quiet mode (no output except errors)\n" <>
    "      --no-color                      Disable colored output\n" <>
    "  -h, --help                          Print help\n" <>
    Nil{})

