# S1.29 S1.89 (data) `br -h`, verbatim
def h_top_short() -> String:
  String.concat(
    "Agent-first issue tracker (SQLite + JSONL)\n" <>
    "\n" <>
    "Usage: br [OPTIONS] <COMMAND>\n" <>
    "\n" <>
    "Commands:\n" <>
    "  agents        Manage AGENTS.md workflow instructions\n" <>
    "  audit         Record and label agent interactions (append-only JSONL)\n" <>
    "  blocked       List blocked issues\n" <>
    "  capabilities  Describe br's machine-readable contracts and safety guarantees\n" <>
    "  capacity      Workflow capacity management: audited issue-specific exemptions (GitHub #384)\n" <>
    "  changelog     Generate changelog from closed issues\n" <>
    "  close         Close an issue\n" <>
    "  comments      Manage comments\n" <>
    "  completions   Generate shell completions\n" <>
    "  config        Configuration management\n" <>
    "  coordination  Diagnose swarm coordination state without mutating claims\n" <>
    "  count         Count issues with optional grouping\n" <>
    "  create        Create a new issue\n" <>
    "  defer         Defer issues (schedule for later)\n" <>
    "  delete        Delete an issue (creates tombstone)\n" <>
    "  dep           Manage dependencies\n" <>
    "  doctor        Run diagnostics and optionally repair issues\n" <>
    "  epic          Epic management commands\n" <>
    "  gate          Workflow gate engine: record and inspect gate results (issue #312)\n" <>
    "  graph         Visualize the dependents graph: what an issue unblocks\n" <>
    "  history       Manage local history backups\n" <>
    "  info          Show diagnostic metadata about the workspace\n" <>
    "  init          Initialize a beads workspace\n" <>
    "  label         Manage labels\n" <>
    "  lint          Check issues for missing template sections\n" <>
    "  list          List issues\n" <>
    "  orphans       List orphan issues (referenced in commits but open)\n" <>
    "  q             Quick capture (create issue, print ID only)\n" <>
    "  query         Manage saved queries\n" <>
    "  ready         List ready issues (open, unblocked, not deferred)\n" <>
    "  reopen        Reopen an issue\n" <>
    "  robot-docs    Print concise in-tool docs for automation agents\n" <>
    "  scheduler     Rank ready work for agent swarms with explainable evidence\n" <>
    "  schema        Emit JSON Schemas and per-command output envelope shapes (for agent/tooling integration)\n" <>
    "  search        Search issues (matches title, description, id, and comment text)\n" <>
    "  show          Show issue details\n" <>
    "  stale         List stale issues\n" <>
    "  stats         Show project statistics\n" <>
    "  status        Alias for stats\n" <>
    "  sync          Sync database with JSONL file (export or import)\n" <>
    "  undefer       Undefer issues (make ready again)\n" <>
    "  update        Update an issue\n" <>
    "  vcs-status    Explicitly inspect Git visibility for the configured JSONL export\n" <>
    "  upgrade       Upgrade br to the latest version\n" <>
    "  version       Show version information\n" <>
    "  where         Show the active .beads directory\n" <>
    "  help          Print this message or the help of the given subcommand(s)\n" <>
    "\n" <>
    "Options:\n" <>
    "      --db <DB>                      Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "      --actor <ACTOR>                Actor name for audit trail\n" <>
    "      --json                         Output as JSON\n" <>
    "      --no-daemon                    Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "      --no-auto-flush                Skip auto JSONL export\n" <>
    "      --no-auto-import               Skip auto import check\n" <>
    "      --allow-stale                  Allow stale DB (bypass freshness check warning)\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>  `SQLite` busy/write-lock timeout in ms\n" <>
    "      --no-db                        JSONL-only mode (no DB connection)\n" <>
    "  -v, --verbose...                   Increase logging verbosity (-v, -vv)\n" <>
    "  -q, --quiet                        Quiet mode (no output except errors)\n" <>
    "      --no-color                     Disable colored output\n" <>
    "  -h, --help                         Print help\n" <>
