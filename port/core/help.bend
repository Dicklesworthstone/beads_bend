# core/help — the help texts the port carries (S1.25–S1.29, S1.89).
# GENERATED by scripts/gen-help-bend.py from the spec appendix docs/spec-parts/HELP_TEXTS.md
# (clause S1.89): change the appendix and run the tool; do not edit the texts here.
# Every command level of the surface carries its `--help` and `-h` text; `text` answers "" for any other path.
# The texts are the original's bytes and keep its binary name `br` (DISC-006).
# Nothing here consults the original.
import Base

# S1.29 S1.89 (data) `--help` and the `help` subcommand at the top level, verbatim
def top() -> String:
  String.concat(
    "Agent-first issue tracker (SQLite + JSONL)\n" <>
    "\n" <>
    "Usage: br [OPTIONS] <COMMAND>\n" <>
    "\n" <>
    "Commands:\n" <>
    "  agents        Manage AGENTS.md workflow instructions\n" <>
    "  audit         Record and label agent interactions (append-only JSONL)\n" <>
    "  blocked       List blocked issues\n" <>
    "  capabilities  Describe br's machine-readable contracts and safety guarantees\n" <>
    "  capacity      Workflow capacity management: audited issue-specific exemptions (GitHub #384)\n" <>
    "  changelog     Generate changelog from closed issues\n" <>
    "  close         Close an issue\n" <>
    "  comments      Manage comments\n" <>
    "  completions   Generate shell completions\n" <>
    "  config        Configuration management\n" <>
    "  coordination  Diagnose swarm coordination state without mutating claims\n" <>
    "  count         Count issues with optional grouping\n" <>
    "  create        Create a new issue\n" <>
    "  defer         Defer issues (schedule for later)\n" <>
    "  delete        Delete an issue (creates tombstone)\n" <>
    "  dep           Manage dependencies\n" <>
    "  doctor        Run diagnostics and optionally repair issues\n" <>
    "  epic          Epic management commands\n" <>
    "  gate          Workflow gate engine: record and inspect gate results (issue #312)\n" <>
    "  graph         Visualize the dependents graph: what an issue unblocks\n" <>
    "  history       Manage local history backups\n" <>
    "  info          Show diagnostic metadata about the workspace\n" <>
    "  init          Initialize a beads workspace\n" <>
    "  label         Manage labels\n" <>
    "  lint          Check issues for missing template sections\n" <>
    "  list          List issues\n" <>
    "  orphans       List orphan issues (referenced in commits but open)\n" <>
    "  q             Quick capture (create issue, print ID only)\n" <>
    "  query         Manage saved queries\n" <>
    "  ready         List ready issues (open, unblocked, not deferred)\n" <>
    "  reopen        Reopen an issue\n" <>
    "  robot-docs    Print concise in-tool docs for automation agents\n" <>
    "  scheduler     Rank ready work for agent swarms with explainable evidence\n" <>
    "  schema        Emit JSON Schemas and per-command output envelope shapes (for agent/tooling integration)\n" <>
    "  search        Search issues (matches title, description, id, and comment text)\n" <>
    "  show          Show issue details\n" <>
    "  stale         List stale issues\n" <>
    "  stats         Show project statistics\n" <>
    "  status        Alias for stats\n" <>
    "  sync          Sync database with JSONL file (export or import)\n" <>
    "  undefer       Undefer issues (make ready again)\n" <>
    "  update        Update an issue\n" <>
    "  vcs-status    Explicitly inspect Git visibility for the configured JSONL export\n" <>
    "  upgrade       Upgrade br to the latest version\n" <>
    "  version       Show version information\n" <>
    "  where         Show the active .beads directory\n" <>
    "  help          Print this message or the help of the given subcommand(s)\n" <>
    "\n" <>
    "Options:\n" <>
    "      --db <DB>                      Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "      --actor <ACTOR>                Actor name for audit trail\n" <>
    "      --json                         Output as JSON\n" <>
    "      --no-daemon                    Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "      --no-auto-flush                Skip auto JSONL export\n" <>
    "      --no-auto-import               Skip auto import check\n" <>
    "      --allow-stale                  Allow stale DB (bypass freshness check warning)\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>  `SQLite` busy/write-lock timeout in ms\n" <>
    "      --no-db                        JSONL-only mode (no DB connection)\n" <>
    "  -v, --verbose...                   Increase logging verbosity (-v, -vv)\n" <>
    "  -q, --quiet                        Quiet mode (no output except errors)\n" <>
    "      --no-color                     Disable colored output\n" <>
    "  -h, --help                         Print help\n" <>
    "  -V, --version                      Print version\n" <>
    Nil{})

# S1.29 S1.89 (data) `list --help`, verbatim
def list_long() -> String:
  String.concat(
    "List issues\n" <>
    "\n" <>
    "Usage: br list [OPTIONS]\n" <>
    "\n" <>
    "Options:\n" <>
    "  -s, --status <STATUS>\n" <>
    "          Filter by status (can be repeated; 'all' matches every status)\n" <>
    "\n" <>
    "  -t, --type <TYPE>\n" <>
    "          Filter by issue type (can be repeated)\n" <>
    "\n" <>
    "      --assignee <ASSIGNEE>\n" <>
    "          Filter by assignee\n" <>
    "\n" <>
    "      --unassigned\n" <>
    "          Filter for unassigned issues only\n" <>
    "\n" <>
    "      --id <ID>\n" <>
    "          Filter by specific IDs (can be repeated)\n" <>
    "\n" <>
    "  -l, --label <LABEL>\n" <>
    "          Filter by label (AND logic, can be repeated)\n" <>
    "\n" <>
    "      --label-any <LABEL_ANY>\n" <>
    "          Filter by label (OR logic, can be repeated)\n" <>
    "\n" <>
    "  -p, --priority <PRIORITY>\n" <>
    "          Filter by priority: 0-4 or P0-P4, ranges like 0-1, comma lists; repeatable\n" <>
    "\n" <>
    "      --priority-min <PRIORITY_MIN>\n" <>
    "          Filter by minimum priority (0=critical, 4=backlog)\n" <>
    "\n" <>
    "      --priority-max <PRIORITY_MAX>\n" <>
    "          Filter by maximum priority\n" <>
    "\n" <>
    "      --title-contains <TITLE_CONTAINS>\n" <>
    "          Title contains substring\n" <>
    "\n" <>
    "      --desc-contains <DESC_CONTAINS>\n" <>
    "          Description contains substring\n" <>
    "\n" <>
    "      --notes-contains <NOTES_CONTAINS>\n" <>
    "          Notes contains substring\n" <>
    "\n" <>
    "  -a, --all\n" <>
    "          Include closed issues (default excludes closed)\n" <>
    "\n" <>
    "      --limit <LIMIT>\n" <>
    "          Maximum number of results (0 = unlimited; default: unlimited — the full work surface)\n" <>
    "\n" <>
    "      --offset <OFFSET>\n" <>
    "          Number of results to skip (for pagination, default: 0)\n" <>
    "\n" <>
    "      --sort <SORT>\n" <>
    "          Sort field (`priority`, `created_at`, `updated_at`, `title`)\n" <>
    "\n" <>
    "  -r, --reverse\n" <>
    "          Reverse sort order\n" <>
    "\n" <>
    "      --deferred\n" <>
    "          Include deferred issues\n" <>
    "\n" <>
    "      --overdue\n" <>
    "          Filter for overdue issues\n" <>
    "\n" <>
    "      --long\n" <>
    "          Use long output format\n" <>
    "\n" <>
    "      --pretty\n" <>
    "          Use tree/pretty output format\n" <>
    "\n" <>
    "      --tree\n" <>
    "          Group children under their parents with tree connectors (text output). Hierarchy follows dotted child IDs (`bd-abc.2` under `bd-abc`); a child whose parent is filtered out of the result set is shown at the top level (GitHub #475)\n" <>
    "\n" <>
    "      --wrap\n" <>
    "          Wrap long lines instead of truncating in text output\n" <>
    "\n" <>
    "      --format <FORMAT>\n" <>
    "          Output format (text, json, csv, toon). Env: BR_OUTPUT_FORMAT, TOON_DEFAULT_FORMAT\n" <>
    "\n" <>
    "          Possible values:\n" <>
    "          - text: Human-readable text (default)\n" <>
    "          - json: JSON output\n" <>
    "          - csv:  CSV output with configurable fields\n" <>
    "          - toon: TOON format (token-optimized object notation)\n" <>
    "\n" <>
    "      --stats\n" <>
    "          Show token savings stats when using TOON output\n" <>
    "\n" <>
    "      --fields <FIELDS>\n" <>
    "          CSV fields to include (comma-separated)\n" <>
    "          \n" <>
    "          Available: id, title, description, status, priority, `issue_type`, assignee, owner, `created_at`, `updated_at`, `closed_at`, `due_at`, `defer_until`, notes, `external_ref`\n" <>
    "          \n" <>
    "          Default: id, title, status, priority, `issue_type`, assignee, `created_at`, `updated_at`\n" <>
    "\n" <>
    "      --db <DB>\n" <>
    "          Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "\n" <>
    "      --actor <ACTOR>\n" <>
    "          Actor name for audit trail\n" <>
    "\n" <>
    "      --json\n" <>
    "          Output as JSON\n" <>
    "\n" <>
    "      --no-daemon\n" <>
    "          Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "\n" <>
    "      --no-auto-flush\n" <>
    "          Skip auto JSONL export\n" <>
    "\n" <>
    "      --no-auto-import\n" <>
    "          Skip auto import check\n" <>
    "\n" <>
    "      --allow-stale\n" <>
    "          Allow stale DB (bypass freshness check warning)\n" <>
    "\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>\n" <>
    "          `SQLite` busy/write-lock timeout in ms\n" <>
    "\n" <>
    "      --no-db\n" <>
    "          JSONL-only mode (no DB connection)\n" <>
    "\n" <>
    "  -v, --verbose...\n" <>
    "          Increase logging verbosity (-v, -vv)\n" <>
    "\n" <>
    "  -q, --quiet\n" <>
    "          Quiet mode (no output except errors)\n" <>
    "\n" <>
    "      --no-color\n" <>
    "          Disable colored output\n" <>
    "\n" <>
    "  -h, --help\n" <>
    "          Print help (see a summary with '-h')\n" <>
    Nil{})

