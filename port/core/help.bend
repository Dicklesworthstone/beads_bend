# S1.29 S1.89 (data) `br update --help`, verbatim
def h_update_long() -> String:
  String.concat(
    "Update an issue\n" <>
    "\n" <>
    "Boxed: `UpdateArgs` is the largest argument struct by a wide margin, and keeping it inline would size every `Commands` value to it.\n" <>
    "\n" <>
    "Usage: br update [OPTIONS] [IDS]...\n" <>
    "\n" <>
    "Arguments:\n" <>
    "  [IDS]...\n" <>
    "          Issue IDs to update\n" <>
    "\n" <>
    "Options:\n" <>
    "      --title <TITLE>\n" <>
    "          Update title\n" <>
    "\n" <>
    "  -d, --description <DESCRIPTION>\n" <>
    "          Update description\n" <>
    "          \n" <>
    "          [alias: --body]\n" <>
    "\n" <>
    "      --description-file <PATH>\n" <>
    "          Set the issue description verbatim from a file (or `-` for stdin), replacing the existing value. The entire file content is used unchanged from disk. Mutually exclusive with `-d/--description`; use this for multi-paragraph / markdown descriptions that are fragile to pass through shell quoting\n" <>
    "\n" <>
    "      --design <DESIGN>\n" <>
    "          Update design notes\n" <>
    "\n" <>
    "      --acceptance-criteria <ACCEPTANCE_CRITERIA>\n" <>
    "          Update acceptance criteria\n" <>
    "          \n" <>
    "          [alias: --acceptance]\n" <>
    "\n" <>
    "      --prerequisites <PREREQUISITES>\n" <>
    "          Replace the prerequisite checklist (empty string clears)\n" <>
    "\n" <>
    "      --check-acceptance <ITEMS>\n" <>
    "          Tick acceptance-criteria checklist items in place (GitHub #477).\n" <>
    "          \n" <>
    "          ITEMS is either a comma-separated list of 1-based item numbers (`1,4,5`) or a text selector that must match exactly one item (case-insensitive; an exact match wins, otherwise a unique substring). Repeat the flag for several text selectors. Every item is validated before anything is written, and the rest of the field is left byte-for-byte intact, so this never needs `--force`.\n" <>
    "\n" <>
    "      --uncheck-acceptance <ITEMS>\n" <>
    "          Untick acceptance-criteria checklist items in place; same selectors as `--check-acceptance`\n" <>
    "\n" <>
    "      --add-acceptance <TEXT>\n" <>
    "          Append an unchecked acceptance criterion (`- [ ] TEXT`) to the checklist without rewriting the field. Repeatable, like `--add-label`\n" <>
    "\n" <>
    "      --notes <NOTES>\n" <>
    "          Update additional notes\n" <>
    "\n" <>
    "      --append-notes <TEXT>\n" <>
    "          Append TEXT to notes without rewriting the field (GitHub #480).\n" <>
    "          \n" <>
    "          Existing notes are kept byte-for-byte; TEXT goes on a new line after them (creating the field when empty). Repeatable, like `--add-label`; several values are appended as consecutive lines. Re-running the same append is a no-op when the field already ends with that text. Append-only, so this never needs `--force`.\n" <>
    "\n" <>
    "      --transition-comment <COMMENT>\n" <>
    "          New comment bound atomically to the requested status transition. Required when policy lists `transition_comment` for the transition\n" <>
    "\n" <>
    "  -s, --status <STATUS>\n" <>
    "          Change status. Terminal states (`closed`, `tombstone`) are refused — use the dedicated `br close` / `br delete` commands so close-policy and dependency-rewiring are enforced (beads_rust#301)\n" <>
    "\n" <>
    "  -p, --priority <PRIORITY>\n" <>
    "          Change priority (0-4 or P0-P4)\n" <>
    "\n" <>
    "  -t, --type <TYPE>\n" <>
    "          Change issue type\n" <>
    "\n" <>
    "      --assignee <ASSIGNEE>\n" <>
    "          Assign to user (empty string clears)\n" <>
    "\n" <>
    "      --owner <OWNER>\n" <>
    "          Set owner (empty string clears)\n" <>
    "\n" <>
    "      --claim\n" <>
    "          Atomic claim (assignee=actor + `status=in_progress`)\n" <>
    "\n" <>
    "      --force\n" <>
    "          Force update even if issue is blocked, and allow a destructive rewrite of a non-empty description/design/acceptance-criteria/prerequisites/ notes/agent-context value: clearing it, or replacing it with content shorter than half its current length (GitHub #467, #481). Revisions that keep at least half the length pass without this flag\n" <>
    "\n" <>
    "      --due <DUE>\n" <>
    "          Set due date (empty string clears)\n" <>
    "\n" <>
    "      --defer <DEFER>\n" <>
    "          Set defer until date (empty string clears)\n" <>
    "\n" <>
    "      --estimate <ESTIMATE>\n" <>
    "          Set time estimate\n" <>
    "\n" <>
    "      --add-label <ADD_LABEL>\n" <>
    "          Add label(s)\n" <>
    "\n" <>
    "      --remove-label <REMOVE_LABEL>\n" <>
    "          Remove label(s)\n" <>
    "\n" <>
    "      --set-labels <SET_LABELS>\n" <>
    "          Set label(s) (replaces all) - repeatable like bd\n" <>
    "          \n" <>
    "          [alias: --labels]\n" <>
    "\n" <>
    "      --parent <PARENT>\n" <>
    "          Reparent to new parent (empty string removes parent)\n" <>
    "\n" <>
    "      --external-ref <EXTERNAL_REF>\n" <>
    "          Set external reference\n" <>
    "\n" <>
    "      --source-repo <SOURCE_REPO>\n" <>
    "          Override `source_repo` (display name; usually the repo's basename, e.g. `widget_engine`)\n" <>
    "\n" <>
    "      --source-repo-path <SOURCE_REPO_PATH>\n" <>
    "          Override `source_repo_path` (absolute path to the directory containing the `.beads` folder; populates the canonical filesystem location of the repo for cross-machine sync awareness — see #289)\n" <>
    "\n" <>
    "      --agent-context <AGENT_CONTEXT>\n" <>
    "          Set the `agent_context` governing-instructions JSON (beads_rust#297). Accepts inline JSON or a `@path` to a JSON or YAML file (extension determines parser; YAML is normalized to JSON before storage). Pass `--agent-context \"\"` (empty string) to clear the field back to NULL. Emitted on descendant `br show` / `br update --status in_progress` / `--claim` when `inherited_context.enabled` is set in `.beads/config.yaml`\n" <>
    "\n" <>
    "      --session <SESSION>\n" <>
    "          Set `closed_by_session` when closing\n" <>
    "\n" <>
    "      --agent-name <NAME>\n" <>
    "          Tier 1 attribution: agent name (env: BR_AGENT_NAME). Recorded only\n" <>
    "          \n" <>
    "          [env: BR_AGENT_NAME=]\n" <>
    "\n" <>
    "      --harness <HARNESS>\n" <>
    "          Tier 1 attribution: harness identifier (env: BR_HARNESS). Recorded only\n" <>
    "          \n" <>
    "          [env: BR_HARNESS=]\n" <>
    "\n" <>
    "      --model <MODEL>\n" <>
    "          Tier 1 attribution: model identifier (env: BR_MODEL). Recorded only\n" <>
    "          \n" <>
    "          [env: BR_MODEL=]\n" <>
    "\n" <>
    "      --db <DB>\n" <>
    "          Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "\n" <>
    "      --actor <ACTOR>\n" <>
    "          Actor name for audit trail\n" <>
    "\n" <>
    "      --json\n" <>
    "          Output as JSON\n" <>
    "\n" <>
    "      --no-daemon\n" <>
    "          Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "\n" <>
    "      --no-auto-flush\n" <>
    "          Skip auto JSONL export\n" <>
    "\n" <>
    "      --no-auto-import\n" <>
    "          Skip auto import check\n" <>
    "\n" <>
    "      --allow-stale\n" <>
    "          Allow stale DB (bypass freshness check warning)\n" <>
    "\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>\n" <>
    "          `SQLite` busy/write-lock timeout in ms\n" <>
    "\n" <>
    "      --no-db\n" <>
    "          JSONL-only mode (no DB connection)\n" <>
    "\n" <>
    "  -v, --verbose...\n" <>
    "          Increase logging verbosity (-v, -vv)\n" <>
    "\n" <>
    "  -q, --quiet\n" <>
    "          Quiet mode (no output except errors)\n" <>
    "\n" <>
    "      --no-color\n" <>
    "          Disable colored output\n" <>
    "\n" <>
    "  -h, --help\n" <>
    "          Print help (see a summary with '-h')\n" <>
    Nil{})

