# S1.29 S1.89 (data) `br ready --help`, verbatim
def h_ready_long() -> String:
  String.concat(
    "List ready issues (open, unblocked, not deferred)\n" <>
    "\n" <>
    "Usage: br ready [OPTIONS]\n" <>
    "\n" <>
    "Options:\n" <>
    "      --limit <LIMIT>\n" <>
    "          Maximum number of issues to return (0 = unlimited; default: unlimited — the full ready set)\n" <>
    "          \n" <>
    "          [default: 0]\n" <>
    "\n" <>
    "      --assignee [<ASSIGNEE>]\n" <>
    "          Filter by assignee (no value = current actor)\n" <>
    "\n" <>
    "      --unassigned\n" <>
    "          Show only unassigned issues\n" <>
    "\n" <>
    "  -l, --label <LABEL>\n" <>
    "          Filter by label (AND logic, can be repeated)\n" <>
    "\n" <>
    "      --label-any <LABEL_ANY>\n" <>
    "          Filter by label (OR logic, can be repeated)\n" <>
    "\n" <>
    "  -t, --type <TYPE>\n" <>
    "          Filter by issue type (can be repeated)\n" <>
    "\n" <>
    "  -p, --priority <PRIORITY>\n" <>
    "          Filter by priority: 0-4 or P0-P4, ranges like 0-1, comma lists; repeatable\n" <>
    "\n" <>
    "      --sort <SORT>\n" <>
    "          Sort policy: hybrid (default), priority, oldest\n" <>
    "\n" <>
    "          Possible values:\n" <>
    "          - hybrid:   P0/P1 first by `created_at`, then others by `created_at`\n" <>
    "          - priority: Sort by priority ASC, then `created_at` ASC\n" <>
    "          - oldest:   Sort by `created_at` ASC only\n" <>
    "          \n" <>
    "          [default: hybrid]\n" <>
    "\n" <>
    "      --include-deferred\n" <>
    "          Include deferred issues\n" <>
    "\n" <>
    "      --parent <PARENT>\n" <>
    "          Filter to children of this parent issue ID\n" <>
    "\n" <>
    "  -r, --recursive\n" <>
    "          Include all descendants (grandchildren, etc.) with --parent\n" <>
    "\n" <>
    "      --epic <EPIC>\n" <>
    "          Scope to an epic: ready issues anywhere beneath the given epic/parent ID (sugar for `--parent <id> --recursive`, depth-unbounded and cycle-safe). Composes with --label/--type/--priority/--limit\n" <>
    "\n" <>
    "      --wrap\n" <>
    "          Wrap long lines instead of truncating in text output\n" <>
    "\n" <>
    "      --format <FORMAT>\n" <>
    "          Output format (text, json, toon). Env: BR_OUTPUT_FORMAT, TOON_DEFAULT_FORMAT\n" <>
    "\n" <>
    "          Possible values:\n" <>
    "          - text: Human-readable text (default)\n" <>
    "          - json: JSON output\n" <>
    "          - toon: TOON format (token-optimized object notation)\n" <>
    "\n" <>
    "      --stats\n" <>
    "          Show token savings stats when using TOON output\n" <>
    "\n" <>
    "      --robot\n" <>
    "          Machine-readable output (alias for --json)\n" <>
    "\n" <>
    "      --db <DB>\n" <>
    "          Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "\n" <>
    "      --actor <ACTOR>\n" <>
    "          Actor name for audit trail\n" <>
    "\n" <>
    "      --json\n" <>
    "          Output as JSON\n" <>
    "\n" <>
    "      --no-daemon\n" <>
    "          Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "\n" <>
    "      --no-auto-flush\n" <>
    "          Skip auto JSONL export\n" <>
    "\n" <>
    "      --no-auto-import\n" <>
    "          Skip auto import check\n" <>
    "\n" <>
    "      --allow-stale\n" <>
    "          Allow stale DB (bypass freshness check warning)\n" <>
    "\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>\n" <>
    "          `SQLite` busy/write-lock timeout in ms\n" <>
    "\n" <>
    "      --no-db\n" <>
    "          JSONL-only mode (no DB connection)\n" <>
    "\n" <>
    "  -v, --verbose...\n" <>
    "          Increase logging verbosity (-v, -vv)\n" <>
    "\n" <>
    "  -q, --quiet\n" <>
    "          Quiet mode (no output except errors)\n" <>
    "\n" <>
    "      --no-color\n" <>
    "          Disable colored output\n" <>
    "\n" <>
    "  -h, --help\n" <>
    "          Print help (see a summary with '-h')\n" <>
    Nil{})

# S1.29 S1.89 (data) `br ready -h`, verbatim
def h_ready_short() -> String:
  String.concat(
    "List ready issues (open, unblocked, not deferred)\n" <>
    "\n" <>
    "Usage: br ready [OPTIONS]\n" <>
    "\n" <>
    "Options:\n" <>
    "      --limit <LIMIT>                Maximum number of issues to return (0 = unlimited; default: unlimited — the full ready set) [default: 0]\n" <>
    "      --assignee [<ASSIGNEE>]        Filter by assignee (no value = current actor)\n" <>
    "      --unassigned                   Show only unassigned issues\n" <>
    "  -l, --label <LABEL>                Filter by label (AND logic, can be repeated)\n" <>
    "      --label-any <LABEL_ANY>        Filter by label (OR logic, can be repeated)\n" <>
    "  -t, --type <TYPE>                  Filter by issue type (can be repeated)\n" <>
    "  -p, --priority <PRIORITY>          Filter by priority: 0-4 or P0-P4, ranges like 0-1, comma lists; repeatable\n" <>
    "      --sort <SORT>                  Sort policy: hybrid (default), priority, oldest [default: hybrid] [possible values: hybrid, priority, oldest]\n" <>
    "      --include-deferred             Include deferred issues\n" <>
    "      --parent <PARENT>              Filter to children of this parent issue ID\n" <>
    "  -r, --recursive                    Include all descendants (grandchildren, etc.) with --parent\n" <>
    "      --epic <EPIC>                  Scope to an epic: ready issues anywhere beneath the given epic/parent ID (sugar for `--parent <id> --recursive`, depth-unbounded and cycle-safe). Composes with --label/--type/--priority/--limit\n" <>
    "      --wrap                         Wrap long lines instead of truncating in text output\n" <>
    "      --format <FORMAT>              Output format (text, json, toon). Env: BR_OUTPUT_FORMAT, TOON_DEFAULT_FORMAT [possible values: text, json, toon]\n" <>
    "      --stats                        Show token savings stats when using TOON output\n" <>
    "      --robot                        Machine-readable output (alias for --json)\n" <>
    "      --db <DB>                      Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "      --actor <ACTOR>                Actor name for audit trail\n" <>
    "      --json                         Output as JSON\n" <>
    "      --no-daemon                    Force direct mode (no daemon) - effectively no-op in br v1\n" <>
    "      --no-auto-flush                Skip auto JSONL export\n" <>
    "      --no-auto-import               Skip auto import check\n" <>
    "      --allow-stale                  Allow stale DB (bypass freshness check warning)\n" <>
    "      --lock-timeout <LOCK_TIMEOUT>  `SQLite` busy/write-lock timeout in ms\n" <>
    "      --no-db                        JSONL-only mode (no DB connection)\n" <>
    "  -v, --verbose...                   Increase logging verbosity (-v, -vv)\n" <>
    "  -q, --quiet                        Quiet mode (no output except errors)\n" <>
    "      --no-color                     Disable colored output\n" <>
    "  -h, --help                         Print help (see more with '--help')\n" <>
    Nil{})

