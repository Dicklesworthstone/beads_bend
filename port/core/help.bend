# S1.29 S1.89 (spec twin) route on the level and the form; "" is a level whose help text the port does not carry
def text_pick(long: Bool, top_level: Bool, in_list: Bool, in_dep: Bool, in_label: Bool, in_epic: Bool) -> String:
  match long top_level in_list in_dep in_label in_epic:
    case True{} True{} _ _ _ _:
      top()
    case True{} False{} True{} _ _ _:
      list_long()
    case False{} False{} True{} _ _ _:
      list_short()
    case True{} False{} False{} True{} _ _:
      dep()
    case True{} False{} False{} False{} True{} _:
      label()
    case True{} False{} False{} False{} False{} True{}:
      epic()
    case _ _ _ _ _ _:
      ""

# S1.25 S1.29 S1.89 (spec twin) the help text of a level (`path` is "" at the top, else the words that lead to it);
# `long` is `--help`, the `help` subcommand or a bare group, as opposed to `-h`
def text(+path: String, long: Bool) -> String:
  text_pick(long, String.is_empty(path), String.eq(path, "list"), String.eq(path, "dep"), String.eq(path, "label"), String.eq(path, "epic"))
