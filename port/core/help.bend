    "\n" <>
    "Arguments:\n" <>
    "  [IDS]...  Issue IDs to delete\n" <>
    "\n" <>
    "Options:\n" <>
    "      --reason <REASON>              Delete reason (default: \"delete\") [default: delete]\n" <>
    "      --from-file <FROM_FILE>        Read IDs from file (one per line, # comments ignored)\n" <>
    "      --cascade                      Delete dependents recursively\n" <>
    "      --force                        Bypass dependent checks (orphans dependents)\n" <>
    "      --hard                         Prune tombstones from JSONL immediately\n" <>
    "      --dry-run                      Preview only, no changes\n" <>
    "      --db <DB>                      Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
