    "  [IDS]...\n" <>
    "          Issue IDs\n" <>
    "\n" <>
    "Options:\n" <>
    "      --format <FORMAT>\n" <>
    "          Output format (text, json, toon). Env: BR_OUTPUT_FORMAT, TOON_DEFAULT_FORMAT\n" <>
    "\n" <>
    "          Possible values:\n" <>
    "          - text: Human-readable text (default)\n" <>
    "          - json: JSON output\n" <>
    "          - toon: TOON format (token-optimized object notation)\n" <>
    "\n" <>
    "      --wrap\n" <>
    "          Soft-wrap long lines to the terminal width in text output. Wrapping is now on by default; this flag is kept for backwards compatibility\n" <>
    "\n" <>
    "      --no-wrap\n" <>
    "          Disable soft-wrapping; let long description/comment lines extend past the panel width (the pre-#370 behavior)\n" <>
    "\n" <>
    "      --stats\n" <>
    "          Show token savings stats when using TOON output\n" <>
    "\n" <>
    "      --db <DB>\n" <>
    "          Database path (auto-discover .beads/*.db if not set; env: BEADS_DB)\n" <>
    "\n" <>
