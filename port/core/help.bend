# S1.29 S1.89 (spec twin) the `--help` text of a level; "" is a level whose help text the port does not carry
def text_long(+path: String) -> String:
  Bool.pick(String, String.is_empty(path), top(), Bool.pick(String, String.eq(path, "list"), list_long(), Bool.pick(String, String.eq(path, "dep"), dep(), Bool.pick(String, String.eq(path, "label"), label(), Bool.pick(String, String.eq(path, "epic"), epic(), Bool.pick(String, String.eq(path, "create"), h_create_long(), Bool.pick(String, String.eq(path, "q"), h_q_long(), Bool.pick(String, String.eq(path, "update"), h_update_long(), Bool.pick(String, String.eq(path, "close"), h_close_long(), Bool.pick(String, String.eq(path, "reopen"), h_reopen_long(), Bool.pick(String, String.eq(path, "defer"), h_defer_long(), Bool.pick(String, String.eq(path, "undefer"), h_undefer_long(), Bool.pick(String, String.eq(path, "delete"), h_delete_long(), Bool.pick(String, String.eq(path, "show"), h_show_long(), Bool.pick(String, String.eq(path, "search"), h_search_long(), Bool.pick(String, String.eq(path, "count"), h_count_long(), Bool.pick(String, String.eq(path, "stats"), h_stats_long(), Bool.pick(String, String.eq(path, "ready"), h_ready_long(), Bool.pick(String, String.eq(path, "blocked"), h_blocked_long(), Bool.pick(String, String.eq(path, "where"), h_where_long(), Bool.pick(String, String.eq(path, "version"), h_version_long(), Bool.pick(String, String.eq(path, "dep add"), h_dep_add_long(), Bool.pick(String, String.eq(path, "dep remove"), h_dep_remove_long(), Bool.pick(String, String.eq(path, "dep list"), h_dep_list_long(), Bool.pick(String, String.eq(path, "dep tree"), h_dep_tree_long(), Bool.pick(String, String.eq(path, "dep cycles"), h_dep_cycles_long(), Bool.pick(String, String.eq(path, "label add"), h_label_add_long(), Bool.pick(String, String.eq(path, "label remove"), h_label_remove_long(), Bool.pick(String, String.eq(path, "label list"), h_label_list_long(), Bool.pick(String, String.eq(path, "label list-all"), h_label_list_all_long(), Bool.pick(String, String.eq(path, "label rename"), h_label_rename_long(), Bool.pick(String, String.eq(path, "comments"), h_comments_long(), Bool.pick(String, String.eq(path, "comments add"), h_comments_add_long(), Bool.pick(String, String.eq(path, "comments list"), h_comments_list_long(), Bool.pick(String, String.eq(path, "epic status"), h_epic_status_long(), Bool.pick(String, String.eq(path, "epic close-eligible"), h_epic_close_eligible_long(), ""))))))))))))))))))))))))))))))))))))

# S1.29 S1.89 (spec twin) the `-h` text of a level
def text_short(+path: String) -> String:
  Bool.pick(String, String.eq(path, "list"), list_short(), Bool.pick(String, String.eq(path, "create"), h_create_short(), Bool.pick(String, String.eq(path, "q"), h_q_short(), Bool.pick(String, String.eq(path, "update"), h_update_short(), Bool.pick(String, String.eq(path, "close"), h_close_short(), Bool.pick(String, String.eq(path, "reopen"), h_reopen_short(), Bool.pick(String, String.eq(path, "defer"), h_defer_short(), Bool.pick(String, String.eq(path, "undefer"), h_undefer_short(), Bool.pick(String, String.eq(path, "delete"), h_delete_short(), Bool.pick(String, String.eq(path, "show"), h_show_short(), Bool.pick(String, String.eq(path, "search"), h_search_short(), Bool.pick(String, String.eq(path, "count"), h_count_short(), Bool.pick(String, String.eq(path, "stats"), h_stats_short(), Bool.pick(String, String.eq(path, "ready"), h_ready_short(), Bool.pick(String, String.eq(path, "blocked"), h_blocked_short(), Bool.pick(String, String.eq(path, "where"), h_where_short(), Bool.pick(String, String.eq(path, "version"), h_version_short(), Bool.pick(String, String.eq(path, "dep add"), h_dep_add_short(), Bool.pick(String, String.eq(path, "dep remove"), h_dep_remove_short(), Bool.pick(String, String.eq(path, "dep list"), h_dep_list_short(), Bool.pick(String, String.eq(path, "dep tree"), h_dep_tree_short(), Bool.pick(String, String.eq(path, "dep cycles"), h_dep_cycles_short(), Bool.pick(String, String.eq(path, "label add"), h_label_add_short(), Bool.pick(String, String.eq(path, "label remove"), h_label_remove_short(), Bool.pick(String, String.eq(path, "label list"), h_label_list_short(), Bool.pick(String, String.eq(path, "label list-all"), h_label_list_all_short(), Bool.pick(String, String.eq(path, "label rename"), h_label_rename_short(), Bool.pick(String, String.eq(path, "comments"), h_comments_short(), Bool.pick(String, String.eq(path, "comments add"), h_comments_add_short(), Bool.pick(String, String.eq(path, "comments list"), h_comments_list_short(), Bool.pick(String, String.eq(path, "epic status"), h_epic_status_short(), Bool.pick(String, String.eq(path, "epic close-eligible"), h_epic_close_eligible_short(), Bool.pick(String, String.eq(path, "dep"), h_dep_short(), Bool.pick(String, String.eq(path, "label"), h_label_short(), Bool.pick(String, String.eq(path, "epic"), h_epic_short(), Bool.pick(String, String.is_empty(path), h_top_short(), ""))))))))))))))))))))))))))))))))))))

# S1.25 S1.29 S1.89 (spec twin) the help text of a level (`path` is "" at the top, else the words that lead to it);
# `long` is `--help`, the `help` subcommand or a bare group, as opposed to `-h`
def text(+path: String, long: Bool) -> String:
  match long:
    case True{}:
      text_long(path)
    case False{}:
      text_short(path)
