# acceptance_text: the acceptance-list flags over criteria that mix prose and checklist lines: which lines are items, text selectors (exact, unique substring, ambiguous, absent), number lists, a zero, the untouched rest (S4.398)
@fx=basic
["update","proj-b75","--acceptance-criteria","Intro line\n- [ ] Alpha\n* [X] Beta\n  - [ ] Gamma nested\n- [] Delta\n1. [ ] Epsilon\nplain tail"]
["update","proj-b75","--check-acceptance","beta"]
["update","proj-b75","--check-acceptance","alpha"]
["update","proj-b75","--uncheck-acceptance","Beta"]
["update","proj-b75","--check-acceptance","a"]
["update","proj-b75","--check-acceptance","zzz"]
["update","proj-b75","--check-acceptance","1,3"]
["update","proj-b75","--check-acceptance","0"]
["update","proj-b75","--check-acceptance","2,x"]
["update","proj-b75","--add-acceptance","New one","--json"]
["update","proj-b75","--uncheck-acceptance","1","--uncheck-acceptance","Gamma"]
["show","proj-b75","--json"]
