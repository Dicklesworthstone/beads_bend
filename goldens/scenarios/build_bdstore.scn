# build_bdstore: the scenario that PRODUCES goldens/fixtures/bdstore.jsonl
# (scripts/make-fixture.sh bdstore build_bdstore). The config sidecar of fixture
# cfg_bd makes the original mint `bd-` ids; the saved fixture carries the store
# only, so a case on it takes its prefix from the store (S2.11), the way a real
# workspace whose directory name is not its prefix does.
@fx=cfg_bd
@time=2026-05-06 07:08:09
["create","First bd issue","-p","1"]
["create","Second bd issue","-t","bug"]
["create","Third bd issue","-p","3"]
